table fact_m0_forecast
	lineageTag: 21816532-25d5-41f0-b61b-af61a4c1f55e
	sourceLineageTag: [dbo].[fact_m0_forecast]

	measure 'Total Forecast' =
			
			SUM(fact_m0_forecast[Forecast_Qty])
		lineageTag: d49c91c8-4929-413b-ad9e-59369f8d8fd8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Consumption' =
			
			SUM(fact_m0_forecast[Consumed_Qty])
		lineageTag: 524b93dc-ff88-44fd-9835-be16807b28bd

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variance Qty' =
			
			[Total Consumption] - [Total Forecast]
		lineageTag: e8b6ea4e-46cb-4dde-83a7-f023eacb0a7f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Accuracy %' =
			
			1 -
			ABS(
			    DIVIDE(
			        [Variance Qty],
			        [Total Forecast]
			    )
			)
		lineageTag: a4e68b2f-78b6-49fc-a930-9db52cf30e31

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Risk Bottlers' =
			
			CALCULATE(
			    COUNTROWS(fact_m0_forecast),
			    fact_m0_forecast[Risk_Category] = "Critical"
			)
		formatString: 0
		lineageTag: a0371d16-55bd-40a7-a219-e65334b01ab7

		changedProperty = Name

